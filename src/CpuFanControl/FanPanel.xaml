<UserControl x:Class="CpuFanControl.FanPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CpuFanControl">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="36"/><RowDefinition Height="20"/>
   <RowDefinition Height="178"/><RowDefinition Height="26"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="24"/>
   <RowDefinition Height="46"/>
  </Grid.RowDefinitions>
  <Grid>
   <TextBlock x:Name="FanTitle" Text="CPU 风扇" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Border x:Name="ModeBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
    Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,7" Width="92">
    <TextBlock x:Name="ModeText" Text="正在连接" FontSize="12" Foreground="{StaticResource Accent}" TextAlignment="Center"/>
   </Border>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <local:FanDial x:Name="DutyDial" Width="160" Height="160" HorizontalAlignment="Left" VerticalAlignment="Center"/>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0">
    <TextBlock x:Name="ActualPercentText" Text="—" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="实际占空比" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
    <TextBlock Text="温度" FontSize="12" Foreground="{StaticResource Muted}"/>
    <TextBlock x:Name="TemperatureText" Text="— °C" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,18"/>
    <TextBlock Text="实时转速" FontSize="12" Foreground="{StaticResource Muted}"/>
    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
     <TextBlock x:Name="RpmText" Text="—" FontSize="26" FontWeight="SemiBold"/>
     <TextBlock Text="RPM" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
    </StackPanel>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="4">
   <Grid>
    <TextBlock Text="目标转速" FontSize="14" VerticalAlignment="Center"/>
    <TextBlock x:Name="TargetPercentText" Text="50%" HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold"/>
   </Grid>
   <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True"
    SmallChange="1" LargeChange="10" Foreground="{StaticResource Accent}" Margin="0,11,0,14"
    ValueChanged="SliderChanged" IsEnabled="False"/>
   <UniformGrid x:Name="Presets" Columns="5">
    <Button Content="0%" Tag="0" Click="PresetClick" Margin="0,0,5,0" Padding="4,7" Height="34"/>
    <Button Content="25%" Tag="25" Click="PresetClick" Margin="3,0,4,0" Padding="4,7" Height="34"/>
    <Button Content="50%" Tag="50" Click="PresetClick" Margin="4,0,3,0" Padding="4,7" Height="34"/>
    <Button Content="75%" Tag="75" Click="PresetClick" Margin="5,0,2,0" Padding="4,7" Height="34"/>
    <Button Content="100%" Tag="100" Click="PresetClick" Margin="6,0,0,0" Padding="4,7" Height="34"/>
   </UniformGrid>
  </StackPanel>
  <Grid Grid.Row="6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="AutoButton" Content="恢复自动" Click="AutoClick" IsEnabled="False"/>
   <Button x:Name="ApplyButton" Grid.Column="2" Content="应用" Style="{StaticResource Primary}" Click="ApplyClick" IsEnabled="False"/>
  </Grid>
 </Grid>
</UserControl>
